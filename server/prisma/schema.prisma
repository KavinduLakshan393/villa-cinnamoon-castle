datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Booking {
  id                  String   @id // Format: VCC-YYYY-XXXXXX
  customerName        String
  whatsAppNumber      String
  checkIn             DateTime
  checkOut            DateTime
  totalNights         Int
  weekendNights       Int
  weekdayNights       Int
  dateType            String   // 'WEEKEND' | 'WEEKDAY' | 'MIXED'
  guestCount          Int
  packageId           String
  packageName         String
  mixedWeekdayPkgId   String?
  mixedWeekdayPkgName String?
  notes               String?
  status              String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'DECLINED'
  declineReason       String?
  totalPrice          Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reviews             Review[]
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  guestName   String
  rating      Int      // 1 - 5
  stayType    String   // e.g. "Family Vacation", "Couples Retreat", "Group Gathering"
  title       String
  comment     String
  isPinned    Boolean  @default(false)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model Package {
  id          String   @id
  title       String
  category    String   // 'weekend' | 'weekday'
  rate        Float
  maxPax      Int
  bedrooms    String
  isAc        Boolean  @default(false)
  description String
  inclusions  String   // JSON stringified list of key highlights
  createdAt   DateTime @default(now())
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
