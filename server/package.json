{
  "name": "villa-cinnamoon-castle-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "admin:create": "npm run build --silent && node dist/cli/create-admin.js",
    "admin:reset-password": "npm run build --silent && node dist/cli/reset-admin-password.js",
    "auth:generate-secret": "node scripts/generate-auth-secret.mjs",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "node scripts/verify-database.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.12.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
