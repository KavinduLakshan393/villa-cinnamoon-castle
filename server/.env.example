# Local PostgreSQL example. Replace every value before use.
DATABASE_URL="postgresql://vcc_app:change-me@localhost:5432/villa_cinnamoon_castle?schema=public"

# Hosted/serverless PostgreSQL can expose a pooled runtime URL and a direct
# migration URL. When only one URL is supplied, use it for both values.
DIRECT_URL="postgresql://vcc_app:change-me@localhost:5432/villa_cinnamoon_castle?schema=public"

NODE_ENV="development"
PORT="4000"
FRONTEND_ORIGIN="http://localhost:5173"

# Generate with: npm run auth:generate-secret
AUTH_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TOKEN_TTL_MINUTES="15"
AUTH_REFRESH_TOKEN_TTL_DAYS="7"
TRUST_PROXY="false"
